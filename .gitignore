# Local agent/tooling state
.atl/

# Environment files with secrets (RNF-13); keep the example template
.env
.env.*
!.env.example

# Código generado a partir de proto/ (scripts/gen-proto.sh)
gen/

# Informes JSON de la prueba de carga (artefactos, no resultados versionados)
reports/

# Direcciones y secretos locales del plan A (deploy/nodes/*.example son las plantillas)
deploy/nodes/*.local
