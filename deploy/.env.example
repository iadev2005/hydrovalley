# Plantilla de deploy/.env para el plan B (deploy/compose.yml). Copiarla:
#
#   cp deploy/.env.example deploy/.env
#
# y cambiar la clave. deploy/.env nunca se versiona (RNF-13). Estos valores
# de ejemplo son los que usa la prueba e2e con una base desechable.

# Credenciales de PostgreSQL. Solo las reciben el contenedor de la base de
# datos y la persistencia (regla 5 de CLAUDE.md).
POSTGRES_USER=hydrovalley
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hydrovalley

# Puerto del host en el que se publica nginx (el único publicado en el juego).
HV_HTTP_PORT=8080

# Puertos opcionales para el perfil de monitorización (Prometheus y Grafana).
HV_PROMETHEUS_PORT=9090
HV_GRAFANA_PORT=3001

# Registro y etiqueta de las imágenes. Con `up --build` se construyen en
# local con estos nombres; sin --build, Compose descarga las del pipeline.
HV_REGISTRY=ghcr.io/iadev2005
HV_TAG=dev

# Nivel de registro de los servicios.
LOG_LEVEL=info

