# Proxy de entrada: la única puerta del sistema (patrón Gateway).
#
# Plantilla de la imagen oficial de nginx: al arrancar, envsubst sustituye
# ${API_ADDR}, ${HUB_ADDR} y ${NGINX_RESOLVER} (solo las variables definidas;
# las de nginx como $http_host quedan igual) y escribe conf.d/default.conf.
# Plan B: api:3000 y hub:8081; plan A: 10.68.17.x:3000 y 10.68.17.x:8081.
#
# Los destinos se resuelven en cada petición (proxy_pass con variable y
# resolver), no al arrancar: nginx arranca aunque la API o el hub no estén
# y los encuentra cuando aparecen (regla 5 de portabilidad).
#
# TLS (RNF-12): nginx termina TLS en el 8080, el único puerto publicado.
# ${TLS_CERT_FILE} y ${TLS_KEY_FILE} son un par montado por el laboratorio o
# el autofirmado que genera docker-entrypoint.d/40-tls-cert.sh al arrancar.
# Un segundo servidor en HTTP, solo en 127.0.0.1:8079, atiende el healthcheck
# del contenedor y no es alcanzable desde fuera.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Identificador de petición (RNF-07). Si el cliente trae un X-Request-Id
# válido (UUID o 32 caracteres hexadecimales, como mucho 64 caracteres) se
# reutiliza; si falta o no es válido, se usa el $request_id de nginx. Se
# valida aquí para que nada con saltos de línea ni de longitud arbitraria
# llegue a los registros ni a las cabeceras que nginx envía. La API lo vuelve
# a validar y lo propaga a persistencia y al simulador (metadato gRPC
# x-request-id).
map $http_x_request_id $hv_request_id {
    default $request_id;
    "~^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" $http_x_request_id;
    "~^[0-9a-fA-F]{32}$" $http_x_request_id;
}

# Registro de acceso sin la consulta de la URL: /play?token=… lleva el token
# firmado, y $request y $request_uri incluyen la consulta. Aquí solo va $uri
# (la ruta, sin consulta). No se registran $args, $query_string ni el
# Referer. Cualquier formato nuevo debe seguir esa regla.
log_format hv_safe '$remote_addr - [$time_local] "$request_method $uri $server_protocol" '
                   '$status $body_bytes_sent "$http_user_agent" rid=$hv_request_id';

# Salud del contenedor: HTTP plano y solo por el bucle local.
server {
    listen 127.0.0.1:8079;
    server_tokens off;
    access_log off;

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 404;
    }
}

server {
    listen 8080 ssl;
    server_tokens off;

    ssl_certificate ${TLS_CERT_FILE};
    ssl_certificate_key ${TLS_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    # Sin HSTS: el certificado del laboratorio es autofirmado y el navegador
    # recordaría un aviso que el usuario no puede resolver.

    # HTTP plano en el puerto de HTTPS (código 497 de nginx): redirige al
    # mismo host y puerto que pidió el cliente ($http_host lleva el puerto
    # publicado, no el 8080 interno del contenedor). 308 y no 301: conserva el
    # método y el cuerpo, así que un POST a http:// sigue siendo POST.
    error_page 497 =308 https://$http_host$request_uri;

    access_log /var/log/nginx/access.log hv_safe;

    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 2s;

    # Frontend: archivos estáticos dentro de esta misma imagen (RES-03).
    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # API REST y Swagger (/api/docs). La ruta se reenvía sin cambios.
    location /api/ {
        set $api_upstream http://${API_ADDR};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        # nginx es el único proxy de entrada: se sobrescribe con la IP real
        # del cliente en lugar de añadirla, para que nadie pueda colar una
        # IP falsa en el X-Forwarded-For que envía.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # RNF-07: el mismo id hacia la API y de vuelta al cliente, también en
        # las respuestas que genera nginx (502, 504). La API ya lo devuelve;
        # se oculta la suya para que no salga duplicado.
        proxy_set_header X-Request-Id $hv_request_id;
        proxy_hide_header X-Request-Id;
        add_header X-Request-Id $hv_request_id always;
        proxy_connect_timeout 2s;
        proxy_read_timeout 30s;
    }

    # WebSocket del juego. El hub compara Origin con Host: Host debe llevar
    # el puerto ($http_host, no $host) o el navegador recibe un 403.
    location = /play {
        set $hub_upstream http://${HUB_ADDR};
        proxy_pass $hub_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        # Igual que en /api: se sobrescribe, no se añade (único proxy).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 2s;
        # El hub envía un estado cada segundo; una hora sin nada es una
        # conexión muerta.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
        # El registro de errores copia la línea de la petición completa
        # («request: "GET /play?token=…"»), y $uri no lo evita. En /play solo
        # se registran los errores críticos; los fallos del hub se ven en el
        # estado de la respuesta (registro de acceso) y en el propio hub.
        error_log /dev/stderr crit;
    }

    # TODO(nivel 2): WebSocket del chat (CHAT_ADDR, puerto 8082).
    location /chat {
        default_type application/json;
        return 503 '{"error":"chat_not_implemented"}\n';
    }
}
