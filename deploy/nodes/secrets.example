# Secretos del plan A. Copiar a secrets.local (ignorado por git), rellenar y
# dejar en cada máquina SOLO las líneas de su nodo (el resto no hace falta y
# no debe estar). Nunca se versiona nada con valores reales (RNF-13).
#
# Los valores con `$` (el hash Argon2id) van entre comillas simples.
# La contraseña de PostgreSQL no debe llevar @ : / ? # (va dentro de una URL).
# Cómo generar las claves y el hash: deploy/nodes/README.md, «Secretos».

# Nodo db y nodo persistence (los únicos con credenciales de PostgreSQL).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Nodo persistence (el único con el hash; vacíos, no se crea administrador).
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Nodo proxy (la API firma con la privada; PEM o su base64 en una línea).
TOKEN_PRIVATE_KEY=
# Vigencia del token en segundos (opcional; 43200 por defecto).
# TOKEN_TTL_SECONDS=43200

# Nodo hub (verifica con la pública, pareja de la privada).
TOKEN_PUBLIC_KEY=

# Bots (opcional, nodo hub; solo para `--profile bots`): contraseña del
# administrador EN CLARO, no el hash.
HV_ADMIN_USERNAME=
HV_ADMIN_PASSWORD=
